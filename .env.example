# Created automatically by the Keystatic setup wizard at /keystatic.
# Copy these four values into Vercel → Settings → Environment Variables.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Contact form. Get the key at resend.com, then verify annamariamosterlind.com
# there and add the DNS records it gives you in Cloudflare.
RESEND_API_KEY=
# Must be an address on the verified domain.
CONTACT_FROM=Website <noreply@annamariamosterlind.com>
